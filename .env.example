# Supabase connection string. Copy this file to .env and paste yours in.
#
# Supabase dashboard -> Project Settings -> Database -> Connection string
#   * "Transaction pooler" (port 6543) for this app -- it is what Supabase
#     recommends for short-lived connections, which is all this app makes.
#   * Replace [YOUR-PASSWORD] with the database password you set when the
#     project was created (Settings -> Database -> Reset password if lost).
#
# .env is gitignored. The password in it is full write access to your data,
# so it does not belong in a commit, a screenshot or a shared log.

DATABASE_URL=postgresql://postgres.abcdefghijklm:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Never put the real password in this file. It is committed; .env is not.
